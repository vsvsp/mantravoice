<!DOCTYPE html>
<html lang="te">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<meta name="theme-color" content="#5b2c83">

<title>MantraVoice</title>

<style>
*{
    box-sizing:border-box;
    margin:0;
    padding:0;
}

body{
    font-family:Arial,"Noto Sans Telugu",sans-serif;
    background:#f6f3fa;
    color:#29212f;
}

header{
    background:linear-gradient(135deg,#54247b,#8e44ad);
    color:white;
    text-align:center;
    padding:25px 15px;
}

.logo{
    font-size:28px;
    font-weight:bold;
}

.tagline{
    margin-top:7px;
    font-size:14px;
}

.container{
    max-width:600px;
    margin:auto;
    padding:18px;
}

.intro{
    text-align:center;
    padding:20px 5px;
}

.intro h1{
    font-size:25px;
    margin-bottom:10px;
}

.intro p{
    color:#6d6575;
    line-height:1.6;
}

.card{
    background:white;
    border-radius:20px;
    padding:20px;
    margin-bottom:16px;
    box-shadow:0 5px 20px rgba(0,0,0,.08);
}

label{
    display:block;
    font-weight:bold;
    margin-bottom:8px;
}

input{
    width:100%;
    padding:15px;
    border:1px solid #ddd5e4;
    border-radius:12px;
    font-size:17px;
    margin-bottom:18px;
    outline:none;
}

input:focus{
    border-color:#8e44ad;
}

.targets{
    display:flex;
    flex-wrap:wrap;
    gap:8px;
}

.targets button{
    flex:1;
    min-width:60px;
    padding:11px 5px;
    border:1px solid #d8cbe2;
    border-radius:10px;
    background:#faf7fc;
    color:#5b2c83;
    font-weight:bold;
}

.counter{
    text-align:center;
}

.small{
    color:#777;
    font-size:14px;
}

.number{
    font-size:78px;
    font-weight:bold;
    color:#5b2c83;
    margin:5px 0;
}

.target{
    font-size:20px;
    color:#666;
}

.progress{
    height:12px;
    background:#eee8f2;
    border-radius:20px;
    margin:20px 0;
    overflow:hidden;
}

.bar{
    height:100%;
    width:0%;
    background:linear-gradient(90deg,#5b2c83,#b565d9);
    transition:.3s;
}

.status{
    color:#666;
    font-size:14px;
}

.buttons{
    display:flex;
    gap:10px;
}

.start{
    flex:2;
    border:0;
    border-radius:15px;
    padding:16px;
    background:#5b2c83;
    color:white;
    font-size:17px;
    font-weight:bold;
}

.stop{
    flex:1;
    border:0;
    border-radius:15px;
    padding:16px;
    background:#e9e3ee;
    color:#5b2c83;
    font-weight:bold;
}

.stop:disabled{
    opacity:.5;
}

.recognized{
    background:#f8f5fa;
    border-radius:12px;
    padding:15px;
    min-height:55px;
    line-height:1.6;
}

.complete{
    display:none;
    text-align:center;
    border:2px solid #d8c2e4;
}

.complete h2{
    color:#5b2c83;
    margin:10px 0;
}

.reset{
    margin-top:15px;
    width:100%;
    padding:14px;
    border:0;
    border-radius:12px;
    background:#5b2c83;
    color:white;
    font-size:16px;
    font-weight:bold;
}

footer{
    text-align:center;
    color:#777;
    padding:25px;
    font-size:13px;
}
</style>
</head>

<body>

<header>
    <div class="logo">🕉️ MantraVoice</div>
    <div class="tagline">
        జపం మీ స్వరం… లెక్క మా బాధ్యత
    </div>
</header>

<div class="container">

<section class="intro">
    <h1>🙏 మంత్ర జపం ప్రారంభించండి</h1>
    <p>
        మీరు మంత్రం పలకండి.<br>
        MantraVoice automaticగా count చేస్తుంది.
    </p>
</section>

<section class="card">

    <label>🕉️ మీ మంత్రం</label>

    <input
        id="mantra"
        value="సాంబ సదాశివాయ నమః"
        placeholder="మంత్రాన్ని టైప్ చేయండి">

    <label>🎯 Target</label>

    <input
        id="target"
        type="number"
        value="1100"
        min="1">

    <div class="targets">

        <button onclick="chooseTarget(11)">11</button>
        <button onclick="chooseTarget(21)">21</button>
        <button onclick="chooseTarget(54)">54</button>
        <button onclick="chooseTarget(108)">108</button>
        <button onclick="chooseTarget(1008)">1008</button>
        <button onclick="chooseTarget(1100)">1100</button>

    </div>

</section>

<section class="card counter">

    <div class="small">ప్రస్తుత జపం</div>

    <div class="number" id="count">0</div>

    <div class="target">
        / <span id="targetDisplay">1100</span>
    </div>

    <div class="progress">
        <div class="bar" id="bar"></div>
    </div>

    <div class="status" id="status">
        🎤 Start నొక్కి మంత్రం పలకండి
    </div>

</section>

<section class="buttons">

    <button
        class="start"
        id="start"
        onclick="startVoice()">
        🎤 Start Japam
    </button>

    <button
        class="stop"
        id="stop"
        onclick="stopVoice()"
        disabled>
        ⏹ Stop
    </button>

</section>

<section class="card">

    <b>🎤 మీరు చెప్పింది:</b>

    <div class="recognized" id="recognized">
        Microphone ప్రారంభించిన తర్వాత
        మీ మాట ఇక్కడ కనిపిస్తుంది.
    </div>

</section>

<section class="card complete" id="complete">

    <div style="font-size:45px;">🙏</div>

    <h2>జపం పూర్తయింది!</h2>

    <p id="completeText"></p>

    <button class="reset" onclick="resetJapam()">
        🔄 మళ్లీ ప్రారంభించండి
    </button>

</section>

<section class="card">

    <b>ℹ️ ఎలా ఉపయోగించాలి?</b>

    <p style="margin-top:12px;line-height:1.8;color:#666;">
        1️⃣ మంత్రాన్ని నమోదు చేయండి.<br>
        2️⃣ Target ఎంచుకోండి.<br>
        3️⃣ 🎤 Start Japam నొక్కండి.<br>
        4️⃣ మంత్రాన్ని స్పష్టంగా పలకండి.<br>
        5️⃣ App గుర్తించినప్పుడు count పెరుగుతుంది.
    </p>

</section>

</div>

<footer>
    🕉️ MantraVoice<br>
    జపం మీ స్వరం… లెక్క మా బాధ్యత
</footer>


<script>

let count = 0;
let target = 1100;
let recognition = null;
let listening = false;

const mantra = document.getElementById("mantra");
const targetInput = document.getElementById("target");
const countBox = document.getElementById("count");
const targetBox = document.getElementById("targetDisplay");
const bar = document.getElementById("bar");
const status = document.getElementById("status");
const recognized = document.getElementById("recognized");
const startButton = document.getElementById("start");
const stopButton = document.getElementById("stop");
const complete = document.getElementById("complete");
const completeText = document.getElementById("completeText");


/* Voice Recognition */

const SpeechRecognition =
    window.SpeechRecognition ||
    window.webkitSpeechRecognition;


if(SpeechRecognition){

    recognition = new SpeechRecognition();

    recognition.continuous = true;

    recognition.interimResults = false;

    recognition.lang = "te-IN";


    recognition.onstart = function(){

        listening = true;

        status.innerText =
            "🎤 వింటున్నాను... మంత్రాన్ని పలకండి";

        startButton.disabled = true;

        stopButton.disabled = false;

    };


    recognition.onresult = function(event){

        let text = "";

        for(
            let i = event.resultIndex;
            i < event.results.length;
            i++
        ){

            if(event.results[i].isFinal){

                text +=
                    event.results[i][0].transcript;

            }

        }


        text = text.trim();

        if(text){

            recognized.innerText = text;

            checkMantra(text);

        }

    };


    recognition.onerror = function(event){

        console.log(event.error);

        status.innerText =
            "⚠️ Voice సమస్య: " + event.error;

        listening = false;

        startButton.disabled = false;

        stopButton.disabled = true;

    };


    recognition.onend = function(){

        listening = false;

        startButton.disabled = false;

        stopButton.disabled = true;

    };

}


/* Start */

function startVoice(){

    if(!recognition){

        alert(
            "ఈ browserలో Voice Recognition support లేదు. Chromeలో ప్రయత్నించండి."
        );

        return;

    }


    if(!mantra.value.trim()){

        alert("ముందుగా మంత్రాన్ని నమోదు చేయండి.");

        return;

    }


    target =
        parseInt(targetInput.value) || 108;

    targetBox.innerText = target;

    complete.style.display = "none";


    try{

        recognition.start();

    }catch(error){

        console.log(error);

    }

}


/* Stop */

function stopVoice(){

    if(recognition && listening){

        recognition.stop();

    }

    listening = false;

    startButton.disabled = false;

    stopButton.disabled = true;

    status.innerText =
        "⏹ జపం ఆపబడింది";

}


/* Text cleanup */

function cleanText(text){

    return text
        .toLowerCase()
        .replace(/[.,!?;:"'`]/g,"")
        .replace(/\s+/g," ")
        .trim();

}


/* Check mantra */

function checkMantra(spoken){

    const wanted =
        cleanText(mantra.value);

    const heard =
        cleanText(spoken);


    if(
        heard.includes(wanted) ||
        wanted.includes(heard)
    ){

        addCount();

    }else{

        status.innerText =
            "🔎 మంత్రం సరిపోలలేదు... మళ్లీ పలకండి";

    }

}


/* Count */

function addCount(){

    if(count >= target){

        return;

    }

    count++;

    countBox.innerText = count;

    let percent =
        (count / target) * 100;

    if(percent > 100){

        percent = 100;

    }

    bar.style.width =
        percent + "%";

    status.innerText =
        "🙏 మంత్రం గుర్తించబడింది";


    if(navigator.vibrate){

        navigator.vibrate(60);

    }


    if(count >= target){

        finish();

    }

}


/* Finish */

function finish(){

    stopVoice();

    complete.style.display = "block";

    completeText.innerText =
        target + " జపాలు పూర్తయ్యాయి 🙏";

    status.innerText =
        "🎉 జపం పూర్తయింది";

    if(navigator.vibrate){

        navigator.vibrate([300,150,300]);

    }

}


/* Target */

function chooseTarget(value){

    targetInput.value = value;

    target = value;

    resetJapam();

}


/* Reset */

function resetJapam(){

    stopVoice();

    count = 0;

    target =
        parseInt(targetInput.value) || 108;

    countBox.innerText = "0";

    targetBox.innerText = target;

    bar.style.width = "0%";

    recognized.innerText =
        "Microphone ప్రారంభించిన తర్వాత మీ మాట ఇక్కడ కనిపిస్తుంది.";

    status.innerText =
        "🎤 Start నొక్కి మంత్రం పలకండి";

    complete.style.display = "none";

}


/* Target change */

targetInput.addEventListener(
    "change",
    function(){

        target =
            parseInt(this.value) || 108;

        resetJapam();

    }
);

</script>

</body>
</html>
