* {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
}

body {
    font-family: Arial, "Noto Sans Telugu", sans-serif;
    background: #f6f3fa;
    color: #29212f;
    min-height: 100vh;
}

header {
    background: linear-gradient(135deg, #54247b, #8e44ad);
    color: white;
    text-align: center;
    padding: 25px 15px;
}

.logo {
    font-size: 28px;
    font-weight: bold;
}

.tagline {
    margin-top: 7px;
    font-size: 14px;
}

main {
    max-width: 600px;
    margin: auto;
    padding: 18px;
}

.intro {
    text-align: center;
    padding: 22px 5px;
}

.intro h1 {
    font-size: 24px;
    margin-bottom: 10px;
}

.intro p {
    color: #6d6575;
    line-height: 1.7;
}

.card {
    background: white;
    border-radius: 20px;
    padding: 20px;
    margin-bottom: 16px;
    box-shadow: 0 5px 20px rgba(0,0,0,.08);
}

label {
    display: block;
    font-weight: bold;
    margin-bottom: 8px;
}

input {
    width: 100%;
    padding: 15px;
    margin-bottom: 18px;
    border: 1px solid #ddd5e4;
    border-radius: 12px;
    font-size: 17px;
    outline: none;
}

input:focus {
    border-color: #8e44ad;
}

.targets {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
}

.targets button {
    flex: 1;
    min-width: 60px;
    padding: 11px 5px;
    border: 1px solid #d8cbe2;
    border-radius: 10px;
    background: #faf7fc;
    color: #5b2c83;
    font-weight: bold;
}

.counter {
    text-align: center;
}

.small {
    color: #777;
    font-size: 14px;
}

.count {
    font-size: 78px;
    font-weight: bold;
    color: #5b2c83;
    margin: 5px 0;
}

.target {
    font-size: 20px;
    color: #666;
}

.progress {
    height: 12px;
    background: #eee8f2;
    border-radius: 20px;
    overflow: hidden;
    margin: 20px 0;
}

.progress-bar {
    height: 100%;
    width: 0%;
    background: linear-gradient(90deg, #5b2c83, #b565d9);
    transition: .3s;
}

.status {
    color: #666;
    font-size: 14px;
}

.buttons {
    display: flex;
    gap: 10px;
    margin-bottom: 16px;
}

.start-button,
.stop-button,
.reset-button {
    border: 0;
    border-radius: 14px;
    padding: 16px;
    font-size: 16px;
    font-weight: bold;
}

.start-button {
    flex: 2;
    background: #5b2c83;
    color: white;
}

.stop-button {
    flex: 1;
    background: #e9e3ee;
    color: #5b2c83;
}

.stop-button:disabled {
    opacity: .5;
}

.section-title {
    font-weight: bold;
    margin-bottom: 10px;
}

.recognized-text {
    background: #f8f5fa;
    padding: 15px;
    border-radius: 12px;
    min-height: 55px;
    line-height: 1.6;
}

.complete-card {
    display: none;
    text-align: center;
    border: 2px solid #d8c2e4;
}

.complete-icon {
    font-size: 45px;
}

.complete-card h2 {
    color: #5b2c83;
    margin: 10px 0;
}

.reset-button {
    width: 100%;
    margin-top: 15px;
    background: #5b2c83;
    color: white;
}

.info h3 {
    margin-bottom: 12px;
}

.info ol {
    padding-left: 22px;
}

.info li {
    margin-bottom: 9px;
    line-height: 1.5;
    color: #666;
}

footer {
    text-align: center;
    color: #777;
    padding: 25px;
    font-size: 13px;
}
